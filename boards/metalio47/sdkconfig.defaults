CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_SPIRAM=y
# 官方RGB/GDMA缓存关闭期间仍须供应行；ISR及其指针表均在内部RAM。/ Keep official RGB/GDMA cache-off feeding safe, with ISR code and pointer tables in internal RAM.
CONFIG_LCD_RGB_ISR_IRAM_SAFE=y
CONFIG_GDMA_CTRL_FUNC_IN_IRAM=y
CONFIG_SPIRAM_MODE_OCT=y
# S31使用独立Flash DIO80、Octal PSRAM200；不套用S3共时钟/HPM规则。
# S31 uses DIO80 flash and Octal200 PSRAM; no S3 MSPI/HPM overrides.
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_SPIRAM_USE_MALLOC=y
# 渲染线程逐行流式读 PSRAM 里的 framebuffer，cache 越大预取越不容易失效
# 多层 EPUB/PNG 调用留安全余量；大型缓存不得放栈上。/ Reserve nested EPUB/PNG stack headroom; keep large caches off-stack.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# 1ms tick：EPD 上电流程里按毫秒轮询 PGOOD，100Hz 的 tick 会把每次等待放大到 10ms
CONFIG_FREERTOS_HZ=1000
# 长文件名以 UTF-8 交给界面与 fopen；磁盘 LFN 保持 UTF-16，不需要增加 CP936 表。
# Pass long filenames to UI and fopen as UTF-8; on-disk LFN stays UTF-16 without a CP936 table.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_API_ENCODING_UTF_8=y

# S31 2.0.66 对照：热路径进IRAM，协议栈优先PSRAM，固定TX减少内部堆碎片。
# S31 2.0.66 comparison: IRAM hot paths, PSRAM-preferred stack and bounded static TX.
# DMA行缓冲仍在内部SRAM；本地对照窗口和报文队列有界到64KiB。
# LCD DMA remains internal; use bounded 64KiB TCP/packet queues for the local S31 comparison.
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_ESP_WIFI_STATIC_TX_BUFFER=y
# CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER is not set
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=6
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=4
CONFIG_ESP_WIFI_RX_BA_WIN=12
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=16
CONFIG_ESP_WIFI_IRAM_OPT=y
CONFIG_ESP_WIFI_RX_IRAM_OPT=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=1024

# 蓝牙：本固件不编入蓝牙（2026-11-25）。去掉后固件小了约 410 KB（5,255,664 → 4,837,504 字节），
# 内部 RAM 也还给 WiFi、I2S 和 AI 对话（实际多出多少看开机日志 wifi pre-init internal free=）。蓝牙翻页器换成空实现（components/ble_page_turner/src/
# ble_page_turner_stub.c），接口不变。要恢复：把这里换回 git 历史里原来的 NimBLE 配置
# （CONFIG_BT_ENABLED=y 及其后的 CONFIG_BT_NIMBLE_*、CONFIG_ESP_COEX_SW_COEXIST_ENABLE、
# CONFIG_BT_CTRL_BLE_ADV_REPORT_FLOW_CTRL_NUM、CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE），
# 并删掉 tools/build_firmware.py 里强制关蓝牙的那一项。
# Bluetooth: not built into this firmware (2026-11-25). Dropping it shrank the firmware by about
# 410 KB (5,255,664 -> 4,837,504 bytes) and returns internal RAM to WiFi, I2S and AI chats (see the
# boot log's "wifi pre-init internal free=" for the actual gain). The page-turner becomes
# a stub (components/ble_page_turner/src/ble_page_turner_stub.c) with the same interface. To
# restore it, put back the original NimBLE settings from git history (CONFIG_BT_ENABLED=y and the
# CONFIG_BT_NIMBLE_*, CONFIG_ESP_COEX_SW_COEXIST_ENABLE, CONFIG_BT_CTRL_BLE_ADV_REPORT_FLOW_CTRL_NUM
# and CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE lines) and drop the forced Bluetooth-off entry in
# tools/build_firmware.py.
# CONFIG_BT_ENABLED is not set

CONFIG_TINYUSB_MSC_ENABLED=y
# U 盘扇区缓冲 8 KB（原 16 KB）：静态与进 U 盘模式时的临时分配各省 8 KB 内部 RAM，拷贝稍慢。
# 8 KB USB drive sector buffer (was 16 KB): saves 8 KB of internal RAM both statically and when
# entering drive mode, at a small cost in copy speed.
CONFIG_TINYUSB_MSC_BUFSIZE=8192
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# rc76: keep transfer listings and TLS allocations out of internal task RAM.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
# 使用SDK交叉签名验证，保留真实证书有效期/主机名检查，不添加废弃根。 / Use SDK cross-signed validation without deprecated roots or bypassing real certificate checks.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# TLS on S31 must remain usable when Wi-Fi and the panel hold internal DMA buffers.
# 保持原版的软件 AES/SHA。硬件 AES 处理 PSRAM 里未对齐的 TLS 记录时，每次要临时借约 1.6 KB 内部 DMA
# 中转缓冲；AI 对话时 WiFi + 墨水屏 + I2S 已把内部 DMA 用到连 1.6 KB 连续块都没有，实测第一句语音
# 就报 “esp-aes: Failed to allocate memory” 断线。
# Keep the stock software AES/SHA. Hardware AES borrows a ~1.6 KB internal-DMA bounce buffer for every
# unaligned TLS record in PSRAM; during an AI chat WiFi + panel + I2S leave not even 1.6 KB contiguous,
# and the first utterance failed on-device with "esp-aes: Failed to allocate memory".
# CONFIG_MBEDTLS_HARDWARE_SHA is not set
# CONFIG_MBEDTLS_HARDWARE_AES is not set
CONFIG_IDF_TARGET="esp32s31"
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_300=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="boards/metalio47/partitions.csv"
CONFIG_READ_PICO_I2C_FREQ_HZ=100000
CONFIG_READ_PICO_I2C_PORT=1
CONFIG_READ_PICO_I2C_SDA_GPIO=0
CONFIG_READ_PICO_I2C_SCL_GPIO=1
CONFIG_READ_PICO_IOE_INT_GPIO=2
CONFIG_READ_PICO_TP_INT_GPIO=5
CONFIG_TINYUSB_DESC_PRODUCT_STRING="kiikoread Metalio S31"
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="kiikoread"


# CONFIG_LWIP_SNTP_STARTUP_DELAY is not set


CONFIG_LWIP_TCP_WND_DEFAULT=65535

# TCP 发送缓冲 32 KB（原 5760，同 Korvo-1 固件）：上行弱时 5.7 KB 很快写满，AI 上传几秒就超时断线；缓冲在 PSRAM。
# 32 KB TCP send buffer (was 5760, as on the Korvo-1): 5.7 KB fills fast on a weak uplink and AI uploads time out; buffers are PSRAM.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=32768

CONFIG_LWIP_TCP_RECVMBOX_SIZE=64

CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64

# Bounded out-of-order reception and selective ACKs avoid whole-window retransmission.
CONFIG_LWIP_TCP_OOSEQ_MAX_PBUFS=48
CONFIG_LWIP_TCP_SACK_OUT=y

# 原厂S31固定聚合/报文预算。/ Vendor S31 aggregation and packet budgets.
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=y
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y
CONFIG_ESP_WIFI_TX_BA_WIN=64
CONFIG_LWIP_TCP_MSS=1440
CONFIG_LWIP_SO_RCVBUF=y

# 原厂PSRAM优先阈值与管理帧预算。/ Vendor PSRAM-preferred threshold and management RX budget.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16
CONFIG_ESP_WIFI_RX_MGMT_BUF_NUM_DEF=5
CONFIG_ESP_WIFI_SLP_IRAM_OPT=y

# 环形缓冲的中断版函数放 flash，省 3.4 KB 内部 RAM（板载音频的 UART 驱动会链接进来；UART 中断不在 IRAM，安全）。
# Ring-buffer ISR functions in flash save 3.4 KB of internal RAM (the on-board audio UART driver pulls
# them in; the UART ISR is not in IRAM, so this is safe).
CONFIG_RINGBUF_PLACE_ISR_FUNCTIONS_INTO_FLASH=y

# AI 语音诊断：任务运行时统计，用来查播放断供时是谁占着 CPU（每个任务多十几字节）。
# AI voice diagnostics: per-task run-time stats, to see who holds the CPU when playback starves
# (about a dozen bytes per task).
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

# 联网诊断：lwIP 收发计数，查连接请求是否发出、回应是否收到、在哪一层被丢（静态几百字节）。
# Network diagnostics: lwIP counters, to see whether connect requests leave, whether replies arrive,
# and at which layer they are dropped (a few hundred static bytes).
CONFIG_LWIP_STATS=y

# 联网诊断：每次开 WiFi 都做完整射频校准，不复用存下的部分校准数据（多耗约百毫秒）。
# 验证"刚连上几秒到几十秒发包无应答"是否来自过期的校准数据。
# Network diagnostics: full RF calibration on every WiFi start instead of reusing stored partial
# calibration data (about 100 ms more). Tests whether the uplink stall right after joining comes from
# stale calibration data.
CONFIG_ESP_PHY_RF_CAL_FULL=y
# CONFIG_ESP_PHY_RF_CAL_PARTIAL is not set
